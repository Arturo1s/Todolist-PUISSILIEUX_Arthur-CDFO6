import os
from datetime import datetime

# Task list
tasks = []

def display_menu():
    print("\n=== Todo List Application ===")
    print("1. View Tasks")
    print("2. Add Task")
    print("3. Delete Task")
    print("4. Mark Task as Completed")
    print("5. Exit ")

def view_tasks():
    if not tasks:
        print("\nNo tasks found!")
        return
    print("\nTasks:")
    for i, (task, completed, due_date) in enumerate(tasks, start=1):
        status = "[\u2713]" if completed else "[ ]"
        due_date_str = f" (Due: {due_date})" if due_date else ""
        print(f"{i}. {status} {task}{due_date_str}")

def add_task():
    task = input("\nEnter the task: ").strip()
    if not task:
        print("Task cannot be empty!")
        return
    
    due_date_str = input("Enter the due date (YYYY-MM-DD) or leave blank: ").strip()
    due_date = None
    if due_date_str:
        try:
            due_date = datetime.strptime(due_date_str, "%Y-%m-%d").date()
        except ValueError:
            print("Invalid date format! Task will be added without a due date.")
    
    tasks.append((task, False, due_date))
    print(f"Task '{task}' added successfully!")

def delete_task():
    view_tasks()
    try:
        task_num = int(input("\nEnter the task number to delete: "))
        if 1 <= task_num <= len(tasks):
            removed_task = tasks.pop(task_num - 1)
            print(f"Task '{removed_task[0]}' deleted successfully!")
        else:
            print("Invalid task number!")
    except ValueError:
        print("Please enter a valid number!")

def mark_task_completed():
    view_tasks()
    try:
        task_num = int(input("\nEnter the task number to mark as completed: "))
        if 1 <= task_num <= len(tasks):
            task, _, due_date = tasks[task_num - 1]
            tasks[task_num - 1] = (task, True, due_date)
            print(f"Task '{task}' marked as completed!")
        else:
            print("Invalid task number!")
    except ValueError:
        print("Please enter a valid number!")

def main():
    while True:
        display_menu()
        choice = input("\nChoose an option: ").strip()
        if choice == "1":
            view_tasks()
        elif choice == "2":
            add_task()
        elif choice == "3":
            delete_task()
        elif choice == "4":
            mark_task_completed()
        elif choice == "5":
            print("\nGoodbye!")
            break
        else:
            print("Invalid choice! Please select a valid option.")

if __name__ == "__main__":
    main()
